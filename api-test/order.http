### ===================================================================
### [멱등성 테스트] Idempotency 보장 로직 검증
### ===================================================================

# 2. 고유 이벤트 ID 생성
@fixed_event_id = 99999999-9999-9999-9999-999999999999

@inventoryUrl = http://localhost:19900

### 1. 내부 통신용 토큰 가져오기
GET http://localhost:19700/test/internal-token?audience=inventory-service

> {%
    client.global.set("inv_internal_token", response.body);
    client.log("전역변수 저장 완료: inv_internal_token");
%}

### [멱등성] STEP 1. 첫 번째 재고 복구 요청 (정상)
POST {{inventoryUrl}}/internal/stocks/restore
Content-Type: application/json
X-Internal-Token: {{inv_internal_token}}

{
    "optionId": "{{ord_option_id_2_1}}",
    "quantity": 1,
    "eventId": "{{fixed_event_id}}"
}

> {%
    client.test("첫 번째 복구 성공", function () {
        client.assert(response.status === 200, "여전히 403이라면 inv_internal_token이 비어있는지 확인 필요.");
        client.log("첫 번째 성공! (eventId: " + client.global.get("idempotent_event_id") + ")");
    });
%}

### [멱등성] STEP 2. 두 번째 중복 요청 (방어 성공 확인)
POST {{inventoryUrl}}/internal/stocks/restore
Content-Type: application/json
X-Internal-Token: {{inv_internal_token}}

{
    "optionId": "{{ord_option_id_2_1}}",
    "quantity": 1,
    "eventId": "{{fixed_event_id}}"
}

> {%
    client.test("두 번째 중복 요청 멱등성 방어 확인", function () {
        client.assert(response.status === 200, "방어 성공!");
        client.log("🛡️ 중복 요청 차단됨! 인벤토리 콘솔 창의 [Idempotency] 로그를 확인하기.");
    });
%}


### [시나리오 3] 정상 주문 (OrderStore.saveOrder 검증) - 목적: 외부 API 호출 후, 트랜잭션이 분리된 OrderStore가 주문을 잘 저장하는지 확인
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{dummy_user_token}}

{
    "restaurantId": "{{dummy_restaurant_id}}",
    "reservationId": "{{dummy_reservation_id}}",
    "orderName": "정상 트랜잭션 분리 테스트",
    "receivingMethod": "PICKUP",
    "expiredAt": "2026-06-01T18:00:00",
    "items": [
        {
            "optionId": "{{ord_option_id_2_1}}",
            "quantity": 1
        }
    ]
}

> {%
    client.test("정상 주문 저장 확인", function () {
        client.assert(response.status === 200, "주문 생성 실패!");
        client.log("[DB 확인 필요] p_orders 테이블에 데이터가 정상적으로 들어왔는지 확인 필요.");
    });
%}


### [시나리오 4] 실제 데이터 기반 고의 에러 발생 (OrderStore.saveCompensationOutbox 검증)
### ===================================================================

# 목적:
# 1. 아이템 1(정상 수량)은 인벤토리 선점에 성공함
# 2. 아이템 2(과다 수량)는 인벤토리 선점에서 '재고 부족' 에러(500) 발생
# 3. 결과: 전체 주문은 롤백(p_orders에 없음)되지만,
#    성공했던 아이템 1에 대한 보상 트랜잭션은 DB에 남아야 함(p_order_outbox에 저장됨)

# 예약 중복 에러를 피하기 위해 매번 새로운 예약 ID로 시뮬레이션... 근데 그냥 예약 직접 만드는 게 나음
@fresh_test_reservation_id = {{$uuid}}

POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{ord_userToken}}

{
    "restaurantId": "{{ord_restaurantId_2}}",
    "reservationId": "af9109cb-9ae7-49ed-b5f8-36e883c19c41",
    "orderName": "실제 데이터 기반 보상 로직 테스트",
    "receivingMethod": "PICKUP",
    "expiredAt": "2026-12-31T18:00:00",
    "items": [
        {
            "optionId": "{{ord_option_id_2_1}}",
            "quantity": 1
        },
        {
            "optionId": "{{ord_option_id_2_2}}",
            "quantity": 99999999
        }
    ]
}

> {%
    client.test("보상 로직 작동 확인", function () {
        client.assert(response.status >= 400, "에러가 발생해야 정상입니다.");
        client.log("요청 완료! TraceId: " + response.body.traceId);
        client.log("DB에서 다음을 확인하기:");
        client.log("1. p_orders 테이블: reservation_id = " + client.global.get("fresh_test_reservation_id") + " 데이터가 없어야 함 (Rollback)");
        client.log("2. p_order_outbox 테이블: " + client.global.get("ord_option_id_2_1") + " 에 대한 STOCK_RESTORE 이벤트가 1줄 있어야 함 (REQUIRES_NEW 성공)");
    });
%}


### [카오스] 1. (인벤토리 켜진 상태) 정상 주문 1건 만들기
POST http://localhost:19000/api/v1/orders
