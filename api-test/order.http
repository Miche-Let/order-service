### 17. 다중 주문 2 생성 (예약 2 사용 - "외 N건" 검증)
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{ord_userToken}}

{
    "restaurantId": "{{ord_restaurantId_2}}",
    "reservationId": "{{ord_reservation_receive}}",
    "receivingMethod": "PICKUP",
    "expiredAt": "2026-06-01T18:00:00",
    "items": [
        { "optionId": "{{ord_option_id_2_1}}", "quantity": 2 },
        { "optionId": "{{ord_option_id_2_2}}", "quantity": 1 }
    ]
}

> {%
    client.test("시스템 자동 이름 생성 확인 (상품 외 N건)", function () {
        client.assert(response.body.data.orderName === "미슐랭 스페셜 코스 2 외 1건", "자동 이름 생성 오류");
        client.global.set("ord_received_order_id", response.body.data.orderId);
        client.log("전역변수 저장: ord_received_order_id = " + response.body.data.orderId);
    });
%}

### 17-1. [검증] 카프카 비동기 처리 완료 확인 (주문 상태가 확정되었는지 눈으로 확인)
GET {{gatewayUrl}}/api/v1/orders/{{ord_received_order_id}}
Accept: application/json
Authorization: Bearer {{ord_ownerToken}}

> {%
    client.test("Kafka 비동기 처리 완료 확인", function () {
        var status = response.body.data.status;
        // 확정 상태(COMPLETED 또는 OCCUPIED 등)로 바뀌었는지 확인
        client.log("현재 주문 상태: " + status + " (이 상태가 PENDING이 아니어야 수령 가능)");
    });
%}

### 17-2. [Update] 주문 완료 처리 (임시 결제 완료 마킹)
# 실제로는 결제 모듈 연동 후 이벤트 기반으로 처리될 예정이나, 테스트를 위해 수동 API 호출
PATCH {{gatewayUrl}}/api/v1/orders/{{ord_received_order_id}}/complete
Authorization: Bearer {{ord_ownerToken}}

> {%
    client.test("임시 결제 완료(COMPLETED) 처리 성공", function () {
        client.assert(response.status === 200, "주문 완료 처리에 실패했습니다!");
        client.log("주문이 COMPLETED 상태로 전환되었습니다. 이제 수령(RECEIVE)이 가능합니다.");
    });
%}

### 18. [Update] 오너 수령 완료 처리 (OWNER 권한)
PATCH {{gatewayUrl}}/api/v1/orders/{{ord_received_order_id}}/receive
Authorization: Bearer {{ord_ownerToken}}

