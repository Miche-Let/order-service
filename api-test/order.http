POST {{gatewayUrl}}/api/v1/products
Content-Type: application/json
Authorization: Bearer {{ord_ownerToken}}

{
    "restaurantId": "{{ord_restaurantId_2}}",
    "name": "오더용 미슐랭 2 예약 한정 코스",
    "category": "MEALKIT",
    "basePrice": 100000,
    "attributes": {},
