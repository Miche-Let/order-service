### 10. 취소용 타임 슬롯 목록 조회 (미래 날짜) [시나리오 1] 레스토랑 1: 미래 날짜(5월 15일) 예약 -> 주문 취소(CANCEL) 검증
GET {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_1}}/time-slots?targetDate={{ord_targetDate_cancel}}
Authorization: Bearer {{ord_userToken}}

> {%
    const timeSlots = response.body.data;
    const openedSlots = timeSlots.filter(slot => slot.status === "OPENED");

    client.test("취소용 슬롯 확인", function () {
        client.assert(openedSlots.length >= 1, "OPENED 상태의 슬롯이 없습니다!");
        client.global.set("ord_timeSlotId_cancel", openedSlots[0].timeSlotId);
        client.global.set("ord_slotStartTime_cancel", openedSlots[0].startTime);
        client.log("전역변수 저장: ord_timeSlotId_cancel = " + openedSlots[0].timeSlotId);
        client.log("전역변수 저장: ord_slotStartTime_cancel = " + openedSlots[0].startTime);
    });
%}

### 11. 예약 1 생성 (레스토랑 1 미래 날짜 슬롯 사용)
POST {{gatewayUrl}}/api/v1/reservations
Authorization: Bearer {{ord_userToken}}
X-Waiting-Token: {{ord_waitingToken_1}}
Content-Type: application/json

{
  "restaurantId": "{{ord_restaurantId_1}}",
  "timeSlotId": "{{ord_timeSlotId_cancel}}",
  "reservedDate": "{{ord_targetDate_cancel}}",
  "slotStartTime": "{{ord_slotStartTime_cancel}}",
  "guestCount": 2,
  "courses": [ { "courseId": "{{ord_courseId_1}}", "quantity": 2, "unitPrice": {{ord_courseUnitPrice}} } ]
}

> {%
    client.global.set("ord_reservation_cancel", response.body.data.reservationId);
    client.log("전역변수 저장: ord_reservation_cancel = " + response.body.data.reservationId);
%}

### 12. 주문 1 생성 (예약 1 사용)
POST {{gatewayUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{ord_userToken}}

{
    "restaurantId": "{{ord_restaurantId_1}}",
    "reservationId": "{{ord_reservation_cancel}}",
    "orderName": "미슐랭 코스 취소용 주문",
    "receivingMethod": "PICKUP",
    "expiredAt": "2026-06-01T18:00:00",
    "items": [ { "optionId": "{{ord_option_id_1_1}}", "quantity": 1 } ]
}

> {%
    client.global.set("ord_canceled_order_id", response.body.data.orderId);
    client.log("전역변수 저장: ord_canceled_order_id = " + response.body.data.orderId);
%}

### 13. [Update] 주문 1 단건 취소 (USER 본인 권한)
PATCH {{gatewayUrl}}/api/v1/orders/{{ord_canceled_order_id}}/cancel
Authorization: Bearer {{ord_userToken}}

### 14. [검증] 취소된 주문 1 상태 확인 (CANCELED)
GET {{gatewayUrl}}/api/v1/orders/{{ord_canceled_order_id}}
Accept: application/json
Authorization: Bearer {{ord_userToken}}

> {%
    client.test("주문 상태 CANCELED 전이 완벽 확인", function () {
        client.assert(response.body.data.status === "CANCELED", "주문이 CANCELED 상태가 아닙니다!");
        client.log("성공! 주문 1 CANCELED 검증 완료");
    });
%}

### 15. 수령용 타임 슬롯 목록 조회 (오늘 날짜) [시나리오 2] 레스토랑 2: 오늘 날짜(5월 9일) 예약 -> 수령 완료(RECEIVE) 검증
GET {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_2}}/time-slots?targetDate={{ord_targetDate_receive}}
Authorization: Bearer {{ord_userToken}}

> {%
    const timeSlots = response.body.data;
    client.log("현재 서버에서 내려온 슬롯 데이터: " + JSON.stringify(timeSlots));
    const openedSlots = timeSlots.filter(slot => slot.status === "OPENED");

    client.test("수령용 슬롯 확인", function () {
        client.assert(openedSlots.length >= 1, "OPENED 상태의 슬롯이 없습니다! (생성 시간이 이미 지나간 시간인지 확인하세요)");
        client.global.set("ord_timeSlotId_receive", openedSlots[0].timeSlotId);
        client.global.set("ord_slotStartTime_receive", openedSlots[0].startTime);
        client.log("전역변수 저장: ord_timeSlotId_receive = " + openedSlots[0].timeSlotId);
        client.log("전역변수 저장: ord_slotStartTime_receive = " + openedSlots[0].startTime);
    });
%}

