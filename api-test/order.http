### 1. [주문 생성] 비동기 처리 확인 (201 Created)
# 카탈로그 서버가 켜져 있어야 하며, DB에 존재하는 실제 optionId를 넣어야 함
POST http://localhost:19000/api/v1/orders
Authorization: Bearer {{ord_userToken}}
Content-Type: application/json

{
    "restaurantId": "22222222-2222-2222-2222-222222222222",
    "reservationId": "{{$random.uuid}}",
    "orderName": "Saga 비동기 E2E 테스트 주문",
    "receivingMethod": "PICKUP",
    "reservedDate": "{{ord_targetDate_receive}}",
    "expiredAt": "2026-06-01T18:00:00",
    "items": [
        {
            "optionId": "44444444-4444-4444-4444-444444444444",
            "quantity": 1
        }
    ]
}

> {%
    client.test("주문 생성 성공 (카탈로그 검증 통과)", function () {
        client.assert(response.status === 201, "201 응답 실패! (카탈로그 optionId가 DB에 없거나 카탈로그 서버가 꺼져있을 수 있음)");
        client.global.set("created_order_id", response.body.data.orderId);
        client.log("성공적으로 큐에 적재됨. 생성된 주문 ID: " + response.body.data.orderId);
    });
%}

### 2. [주문 취소] 생성된 ID로 취소 요청 (200 OK)
# 이 요청을 보내기 직전에 인벤토리 서버를 끄고 보내면 장애 격리 테스트
PATCH http://localhost:19000/api/v1/orders/{{created_order_id}}/cancel
Authorization: Bearer {{ord_userToken}}
Content-Type: application/json

> {%
    client.test("주문 취소 성공 (장애 격리 및 보상 트랜잭션)", function () {
        client.assert(response.status === 200, "200 OK 응답이 아닙니다.");
        client.log("취소 성공! DB의 Outbox 테이블에 STOCK_RESTORE 이벤트가 쌓였는지 확인 필요.");
    });
%}
