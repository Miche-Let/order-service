    },
    "options": [
        { "name": "미슐랭 스페셜 코스 2", "addPrice": 0, "totalQuantity": 50, "dailyLimit": 10, "maxLimit": 4 },
        { "name": "추가 와인 페어링 2", "addPrice": 50000, "totalQuantity": 50, "dailyLimit": 10, "maxLimit": 4 }
    ]
}

