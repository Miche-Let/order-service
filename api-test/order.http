### 환경변수 설정
@gatewayUrl = http://localhost:19000
# 취소 검증을 위한 미래 날짜 (레스토랑 1)
@ord_targetDate_cancel = 2026-05-15
# 수령 완료 검증을 위한 오늘 날짜 (시스템 기준 5월 9일, 레스토랑 2)
@ord_targetDate_receive = 2026-05-09
@ord_courseUnitPrice = 100000.00

# 슬롯 시작, 끝 시간. 테스트할때마다 수정할것!
@openTime = 23:20:00
@closeTime = 23:45:00

### 1. OWNER 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
    "loginId": "test902",
    "password": "test123!02",
    "name": "owner902",
    "email": "owner00902@naver.com",
    "phone": "010-0000-9999",
    "userRole": "OWNER"
}

### 2. OWNER 로그인
POST {{gatewayUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "loginId": "test902",
    "password": "test123!02"
}

> {%
    client.test("오너 로그인 검증", function () {
        client.assert(response.status === 200, "로그인 실패!");
        client.global.set("ord_ownerToken", response.body.data.accessToken);
        client.log("전역변수 저장: ord_ownerToken");
    });
%}

### 3. USER 회원가입
POST {{gatewayUrl}}/api/v1/users/signup
Content-Type: application/json

{
    "loginId": "test95",
    "password": "test123!5",
    "name": "user95",
    "email": "user0095@naver.com",
    "phone": "010-1000-2005",
    "userRole": "USER"
}

### 4. USER 로그인
POST {{gatewayUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "loginId": "test95",
    "password": "test123!5"
}

> {%
    client.test("유저 로그인 검증", function () {
        client.assert(response.status === 200, "로그인 실패!");
        client.global.set("ord_userToken", response.body.data.accessToken);
        client.log("전역변수 저장: ord_userToken");
    });
%}

### 5-1. 식당 1 등록 (Owner) [기초 데이터 세팅] 레스토랑 1 (취소 테스트용)
POST {{gatewayUrl}}/api/v1/restaurants
Content-Type: application/json
Authorization: Bearer {{ord_ownerToken}}

{
    "name": "MicheLet Dining 1 (취소용)",
    "address": "서울특별시 강남구 테헤란로 123",
    "phone": "02-1234-1111",
    "description": "파인다이닝 레스토랑 1",
    "reservationOpenAt": "10:00:00",
    "avgMealDurationMin": 90,
    "status": "OPEN",
    "businessHours": "MON-FRI 11:00-24:00 / SAT,SUN CLOSED"
}

> {%
    client.global.set("ord_restaurantId_1", response.body.data.restaurantId);
    client.log("전역변수 저장: ord_restaurantId_1 = " + response.body.data.restaurantId);
%}

### 6-1. 코스 1 등록 (Owner)
POST {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_1}}/courses
Content-Type: application/json
Authorization: Bearer {{ord_ownerToken}}

{
    "name": "Dinner Course 1",
    "price": 150000,
    "sessionType": "DINNER",
    "status": "AVAILABLE",
    "menus": [
        {
            "coursePart": "MAIN",
            "menuName": "양갈비",
            "sortOrder": 4
        }
    ]
}

> {%
    client.global.set("ord_courseId_1", response.body.data.courseId);
    client.log("전역변수 저장: ord_courseId_1 = " + response.body.data.courseId);
%}

### 7-1. 타임슬롯 1 일괄 생성 (Owner) - 취소용 날짜
POST {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_1}}/time-slots/bulk
Content-Type: application/json
Authorization: Bearer {{ord_ownerToken}}

{
    "startDate": "{{ord_targetDate_cancel}}",
    "endDate": "{{ord_targetDate_cancel}}",
    "openTime": "{{openTime}}",
    "closeTime": "{{closeTime}}",
    "intervalMinutes": 10,
    "capacity": 4
}

### 8-1. 오더 테스트용 상품 1 등록 (Owner)
POST {{gatewayUrl}}/api/v1/products
Content-Type: application/json
Authorization: Bearer {{ord_ownerToken}}

{
    "restaurantId": "{{ord_restaurantId_1}}",
    "name": "오더용 미슐랭 1 예약 한정 코스",
    "category": "MEALKIT",
    "basePrice": 100000,
    "attributes": {},
    "exhibition": {
        "startAt": "2024-01-01T00:00:00",
        "endAt": "2099-12-31T23:59:59"
    },
    "options": [
        { "name": "미슐랭 스페셜 코스 1", "addPrice": 0, "totalQuantity": 50, "dailyLimit": 10, "maxLimit": 4 }
    ]
}

> {%
    client.global.set("ord_product_id_1", response.body.data.productId);
    client.global.set("ord_option_id_1_1", response.body.data.options[0].optionId);
    client.log("전역변수 저장: ord_product_id_1 = " + response.body.data.productId);
    client.log("전역변수 저장: ord_option_id_1_1 = " + response.body.data.options[0].optionId);
%}

