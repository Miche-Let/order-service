### 10. 취소용 타임 슬롯 목록 조회 (미래 날짜) [시나리오 1] 레스토랑 1: 미래 날짜(5월 15일) 예약 -> 주문 취소(CANCEL) 검증
GET {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_1}}/time-slots?targetDate={{ord_targetDate_cancel}}
Authorization: Bearer {{ord_userToken}}

> {%
    const timeSlots = response.body.data;
    const openedSlots = timeSlots.filter(slot => slot.status === "OPENED");

    client.test("취소용 슬롯 확인", function () {
        client.assert(openedSlots.length >= 1, "OPENED 상태의 슬롯이 없습니다!");
        client.global.set("ord_timeSlotId_cancel", openedSlots[0].timeSlotId);
        client.global.set("ord_slotStartTime_cancel", openedSlots[0].startTime);
        client.log("전역변수 저장: ord_timeSlotId_cancel = " + openedSlots[0].timeSlotId);
        client.log("전역변수 저장: ord_slotStartTime_cancel = " + openedSlots[0].startTime);
    });
%}

