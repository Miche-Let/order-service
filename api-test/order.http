### 15. 수령용 타임 슬롯 목록 조회 (오늘 날짜) [시나리오 2] 레스토랑 2: 오늘 날짜(5월 9일) 예약 -> 수령 완료(RECEIVE) 검증
GET {{gatewayUrl}}/api/v1/restaurants/{{ord_restaurantId_2}}/time-slots?targetDate={{ord_targetDate_receive}}
Authorization: Bearer {{ord_userToken}}

> {%
    const timeSlots = response.body.data;
    client.log("현재 서버에서 내려온 슬롯 데이터: " + JSON.stringify(timeSlots));
    const openedSlots = timeSlots.filter(slot => slot.status === "OPENED");

    client.test("수령용 슬롯 확인", function () {
        client.assert(openedSlots.length >= 1, "OPENED 상태의 슬롯이 없습니다! (생성 시간이 이미 지나간 시간인지 확인하세요)");
        client.global.set("ord_timeSlotId_receive", openedSlots[0].timeSlotId);
        client.global.set("ord_slotStartTime_receive", openedSlots[0].startTime);
        client.log("전역변수 저장: ord_timeSlotId_receive = " + openedSlots[0].timeSlotId);
        client.log("전역변수 저장: ord_slotStartTime_receive = " + openedSlots[0].startTime);
    });
%}

