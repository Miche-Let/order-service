### 환경변수 설정
@gatewayUrl = http://localhost:19000
@ord_courseUnitPrice = 100000.00

# 슬롯 시작, 끝 시간. 테스트할때마다 수정할것!
@openTime = 17:20:00
@closeTime = 23:45:00

### 0. [날짜 준비] JS로 동적 날짜 계산 및 글로벌 변수 할당
GET https://httpbin.org/get

> {%
    function getFormattedDate(daysToAdd) {
        const date = new Date();
        date.setDate(date.getDate() + daysToAdd);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return year + '-' + month + '-' + day;
    }

    const receiveDate = getFormattedDate(0); // 오늘 (수령일)
    const cancelDate = getFormattedDate(5);  // 5일 뒤 (만료일/취소테스트용)

    client.global.set("ord_targetDate_receive", receiveDate);
    client.global.set("ord_targetDate_cancel", cancelDate);

    client.test("날짜 변수 할당 성공", function () {
        client.assert(client.global.get("ord_targetDate_receive") !== undefined);
        client.log("계산된 수령일: " + receiveDate);
        client.log("계산된 만료일: " + cancelDate);
    });
%}

### 1. OWNER 회원가입
